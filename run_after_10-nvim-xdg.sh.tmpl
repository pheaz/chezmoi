{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/sh
main() {
    source={{ joinPath .chezmoi.sourceDir "configs" "nvim" | shellQuote }}
    repo={{ .chezmoi.sourceDir | shellQuote }}
    config={{ env "XDG_CONFIG_HOME" | default (joinPath .chezmoi.homeDir ".config") | clean | shellQuote }}
    default_config={{ joinPath .chezmoi.homeDir ".config" | shellQuote }}
    [ "$config" != "$default_config" ] || return 0
    case "$config" in
        /*) ;;
        *) printf '%s\n' 'XDG_CONFIG_HOME must be absolute.' >&2; return 1 ;;
    esac
    target=$config/nvim
    if [ -L "$target" ]; then
        link=$(readlink "$target") || return 1
        [ "$link" != "$source" ] || return 0
        old=$(git -C "$repo" config --local --get chezmoiMigration.oldSourceDir 2>/dev/null)
        if [ "$link" = "$repo/dot_config/nvim" ] || { [ -n "$old" ] && {
            [ "$link" = "$old/dot_config/nvim" ] || [ "$link" = "$old/components/nvim/files" ];
        }; }; then
            rm "$target" || return 1
        fi
    fi
    if [ -e "$target" ] || [ -L "$target" ]; then
        printf 'Refusing unrelated Neovim target: %s\n' "$target" >&2
        return 1
    fi
    mkdir -p "$config" || return 1
    ln -s "$source" "$target" || return 1
}
main
{{ end -}}
